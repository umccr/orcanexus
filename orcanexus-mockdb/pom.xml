<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.ccgcm.platform</groupId>
        <artifactId>orcanexus</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>orcanexus-mockdb</artifactId>

    <name>OrcaNexus Mockdb</name>
    <description>Dev-only CLI that builds the schema and seeds synthetic data into a local PostgreSQL</description>

    <properties>
        <datafaker.version>2.7.0</datafaker.version>
    </properties>

    <dependencies>

        <!-- Internal modules: the generated jOOQ model only -->

        <dependency>
            <groupId>dev.ccgcm.platform</groupId>
            <artifactId>orcanexus-jooq</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>

        <!-- JDBC driver (version managed by Spring Boot) -->

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>

        <!-- Synthetic data -->

        <dependency>
            <groupId>net.datafaker</groupId>
            <artifactId>datafaker</artifactId>
            <version>${datafaker.version}</version>
        </dependency>

        <!-- Tests -->

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>dev.ccgcm.platform.orcanexus.mockdb.MockdbMain</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- DB-backed tests: needs the Compose stack (nexus_docker_up). Without this profile they
             are reported as skipped. -->
        <profile>
            <id>mockdb-it</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <systemPropertyVariables>
                                <mockdb.it>true</mockdb.it>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
